{
  "name": "heimdall",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Heimdall CTF control plane, agent, observer, operator desk, and taps in TypeScript.",
  "bin": {
    "heimdall": "./bin/heimdall",
    "heimdall-agent": "./bin/heimdall-agent",
    "heimdall-observer": "./bin/heimdall-observer",
    "heimdall-llm-tap": "./bin/heimdall-llm-tap",
    "heimdall-http-tap": "./bin/heimdall-http-tap",
    "heimdall-demux": "./bin/heimdall-demux",
    "heimdall-goal": "./bin/heimdall-goal"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:console",
    "build:server": "tsc -p tsconfig.json && node scripts/build/resources.mjs",
    "build:console": "npm --prefix console run build",
    "test": "npm run build:server && vitest run",
    "dev": "tsx src/agent/main.ts",
    "test:release": "node scripts/build/smoke.mjs",
    "package:docker": "node scripts/build/bundle-docker.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
