# Exclude local toolkit leftovers and generated build outputs.
tools/c2
tools/proxy
dist
console/spa
**/*.exe
data
.git
test
tests
.env
**/.env
**/__pycache__
**/node_modules
**/*.pyc
.venv
venv
docs/superpowers
tsecbench
hosted/**/dist
deploy/**/dist
workspaces/**/*.bak
tools/wordlists/*
!tools/wordlists/paths.txt
!tools/wordlists/usernames.txt
!tools/wordlists/passwords.txt
