# Copy to .env. First launch can also start empty and use the console Settings UI.
HEIMDALL_IMAGE=ghcr.io/qiantangcredit/heimdall:latest
HEIMDALL_EXECUTOR_IMAGE=ghcr.io/qiantangcredit/heimdall:executor-latest
# Advanced DinD only: uncomment to enable its separate VPN sidecar.
# HEIMDALL_VPN_ENABLED=1
# Default workspace deployment already manages built-in VPN on demand.
HEIMDALL_BIND=127.0.0.1
HEIMDALL_PORT=8700

# Only used to initialize credentials on the first launch of a NEW data volume.
# Later edits are made in the console and persist in the data volume.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
HEIMDALL_LOOP_API_KEY=
HEIMDALL_LOOP_BASE_URL=
HEIMDALL_LOOP_MODEL=

# Optional platform; leave blank for URL/local lab tasks.
BENCHMARK_BASE_URL=
BENCHMARK_TOKEN=
